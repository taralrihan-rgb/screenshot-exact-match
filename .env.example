# Realtify environment configuration (example — copy to .env and fill in).
# Never commit real credentials. Server-only secrets must never use the
# VITE_ prefix; only VITE_* values are exposed to client-side code.

# Future backend (Lovable Cloud / Supabase) — not used in demo mode:
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=   # server-only, never exposed to the browser
